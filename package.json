{
  "name": "@swiftexwallet/sdk",
  "version": "1.1.0",
  "description": "Official SwiftEx SDK for Stellar (SDEX/Soroban) and EVM multi-chain wallet, cross-chain swaps (1inch, Uniswap, NEAR Intents), RWA tokens, third-party fiat on/off-ramp, and perpetuals (Hyperliquid & Aster).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm test && npm run build"
  },
  "homepage": "https://swiftexchange.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwiftExWallet/swiftex_easy_pnl.git"
  },
  "bugs": {
    "url": "https://github.com/SwiftExWallet/swiftex_easy_pnl/issues",
    "email": "info@swiftexwallet.com"
  },
  "keywords": [
    "swiftex",
    "swiftex-wallet",
    "swiftex-sdk",
    "stellar",
    "sdex",
    "soroban",
    "stellar-pnl",
    "stellar-portfolio",
    "stellar-tracker",
    "stellar-analytics",
    "stellar-tax",
    "xlm-pnl",
    "crypto-pnl",
    "portfolio-tracker",
    "react-pnl-widget",
    "evm-wallet",
    "multichain-wallet",
    "cross-chain-swap",
    "1inch",
    "uniswap",
    "near-intents",
    "rwa",
    "real-world-assets",
    "perpetuals",
    "hyperliquid",
    "aster-dex",
    "fiat-onramp",
    "crypto-offramp",
    "defi"
  ],
  "author": "SwiftEx <info@swiftexwallet.com> (https://swiftexchange.io)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "exceljs": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
